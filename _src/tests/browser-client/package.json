{
  "name": "browser-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "npx ng",
    "dev": "npx ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "start:testserver": "cd ../test-server && tsc && cd ../browser-client && node ../test-server/dst/tests/test-server/testserver.js",
    "test": "start-server-and-test start:testserver http://localhost:8080/ready 'ng test --watch=false --browsers=ChromeHeadless'",
    "debug:test": "npx ng test --browsers=Chrome --source-map=true --no-single-run",
    "test:noserver": "ng test --watch=false --browsers=ChromeHeadless"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "~17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~4.0.0",
    "@types/jest": "^30.0.0",
    "jasmine-core": "~4.1.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "karma-spec-reporter": "^0.0.36",
    "start-server-and-test": "^1.14.0",
    "ts-node": "^10.9.1",
    "typescript": "~5.2.2"
  }
}