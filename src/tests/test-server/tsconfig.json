{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "sourceMap": true,
    "inlineSourceMap": false,
    "declaration": true,
    "outDir": "dst",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "testserver.ts"
  ],
  "exclude": [
    "*.js"
  ]
}
