{
  "name": "nanium",
  "version": "2.0.0",
  "description": "nanoservice based fullstack software architecture framework",
  "author": "twnzl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/twnzl/nanium.git"
  },
  "bugs": {
    "url": "https://github.com/twnzl/nanium/issues"
  },
  "homepage": "https://github.com/twnzl/nanium.git#readme",
  "type": "module",
  "main": "./dist/entries/core.js",
  "types": "./dist/entries/core.d.ts",
  "exports": {
    ".": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./core": {
      "types": "./dist/entries/core.d.ts",
      "import": "./dist/entries/core.js"
    },
    "./browser": {
      "types": "./dist/entries/browser.d.ts",
      "import": "./dist/entries/browser.js"
    },
    "./node": {
      "types": "./dist/entries/node.d.ts",
      "import": "./dist/entries/node.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "bin": {
    "nanium": "./dist/tools/nanium.js"
  },
  "keywords": [
    "nanium",
    "framework",
    "typescript",
    "webdevelopment",
    "api",
    "rest",
    "nanoservices"
  ],
  "scripts": {
    "lint": "tslint \"'src/**/*.ts\" -p tsconfig.json -c tslint.json -e node_modules",
    "build:testserver": "cd src/tests/test-server && tsc && cd ../../..",
    "build": "tsc && node dist/tools/nanium.js ccp src/tools/templates dist/tools/templates && npm run build:testserver",
    "run:testserver": "cd src/tests/test-server && node dst/tests/test-server/testserver.js && cd ../../..",
    "test:server": "export NODE_TLS_REJECT_UNAUTHORIZED=0; vitest run --config vitest.node.config.ts",
    "test:client": "export NODE_TLS_REJECT_UNAUTHORIZED=0; vitest run --config vitest.browser.config.ts",
    "test": "npm run test:server && npm run test:client",
    "prepare": "",
    "publishlist": "npm publish --dry-run",
    "bundle": "npm run build && npm test && npm publish",
    "cleanup": "rm -rf dist && rm -rf src/tests/test-server/dst",
    "cleanbuild": "npm run cleanup && npm run build"
  },
  "files": [
    "README.md",
    "dist",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.js.map",
    "!dist/**/*.spec.d.ts"
  ],
  "dependencies": {
    "parse-multipart-data": "^1.5.0",
    "recursive-readdir": "^2.2.2",
    "shelljs": "^0.8.5",
    "tslib": "^2.8.1",
    "unzipper": "^0.12.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@eslint/json": "^0.14.0",
    "@types/node": "^25.0.3",
    "@types/recursive-readdir": "^2.2.0",
    "@types/shelljs": "^0.8.5",
    "@types/typescript": "^2.0.0",
    "@types/unzipper": "^0.10.10",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser": "^4.0.16",
    "@vitest/browser-playwright": "^4.0.16",
    "eslint": "^9.39.1",
    "playwright": "^1.57.0",
    "ts-node": "^8.3.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.49.0",
    "vitest": "^4.0.16"
  }
}
